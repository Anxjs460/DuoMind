def play_tic_tac_toe():
    game = TicTacToeGame()
    print("\n【双AI井字棋】千问 (O) vs DeepSeek (X)")
    
    while True:
        game.print_board()
        winner = game.check_winner()
        if winner:
            if winner == "O":
                print("\n🏆 千问赢了！")
            elif winner == "X":
                print("\n🏆 DeepSeek赢了！")
            else:
                print("\n🤝 平局！")
            break
        
        if game.turn == 0:
            print("\n【千问思考中...】")
            game.ai_move("O")
            game.turn = 1
        else:
            print("\n【DeepSeek思考中...】")
            game.ai_move("X")
            game.turn = 0
        
        time.sleep(1)
    
    input("\n按回车返回主菜单...")

def code_review():
    print("\n【代码互审模式】输入一段代码，千问负责技术分析，DeepSeek负责嘲讽")
    print("(输入空行结束，输入 /cancel 取消)")
    
    lines = []
    while True:
        line = input("> ")
        if line == "/cancel":
            return
        if line == "":
            break
        lines.append(line)
    
    code = "\n".join(lines)
    if not code.strip():
        print("未输入代码，取消")
        return
    
    print("\n📚 千问 技术分析:")
    qw_prompt = f"请对以下代码进行技术分析，指出结构、异常处理、命名等问题：\n```\n{code}\n```"
    qw_review = query_ollama(MODEL_QWEN, qw_prompt)
    print(qw_review)
    
    print("\n🔍 DeepSeek 锐评:")
    ds_prompt = f"请用一句毒舌的话嘲讽以下代码（如果是元宝写的就更好了）：\n```\n{code}\n```"
    ds_review = query_ollama(MODEL_DEEPSEEK, ds_prompt)
    print(ds_review)
    
    full_review = f"【千问】\n{qw_review}\n\n【DeepSeek】\n{ds_review}"
    save_code_review(code, full_review)
    input("\n按回车返回主菜单...")

def voice_input():
    if not os.path.exists("/data/data/com.termux"):
        print("⚠️ 仅支持 Termux 环境使用语音输入")
        return None
    try:
        print("\n🎤 请说话...（录音3秒）")
        audio_file = "/tmp/duomind_voice.wav"
        subprocess.run(["termux-microphone-record", "-d", "3", "-f", audio_file], timeout=5, check=True)
        print("🎤 识别结果（模拟）: ", end="")
        return input("(请输入识别文字): ")
    except Exception as e:
        print(f"⚠️ 语音输入失败: {e}")
        return None

def get_user_input():
    if not sys.stdin.isatty():
        return DEFAULT_TOPIC
    if voice_input_enabled:
        text = voice_input()
        if text is not None:
            return text
    return input("\n💬 输入对话主题（回车用默认）: ").strip() or DEFAULT_TOPIC

