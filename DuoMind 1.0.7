# ---------- 加载进度显示 ----------
def show_loading_animation(stop_event):
    """显示加载动画"""
    frames = ["[     ]", "[=    ]", "[==   ]", "[===  ]", "[==== ]", "[=====]"]
    i = 0
    while not stop_event.is_set():
        print(f"\r⏳ 模型加载中 {frames[i % len(frames)]}", end="", flush=True)
        i += 1
        time.sleep(0.2)
    print("\r✅ 模型加载完成        ")

def load_model_with_progress(model_name):
    """带进度显示的模型加载"""
    stop_event = threading.Event()
    anim_thread = threading.Thread(target=show_loading_animation, args=(stop_event,))
    anim_thread.start()
    
    try:
        start = time.time()
        result = subprocess.run(
            ["ollama", "run", model_name],
            input="ping",
            text=True,
            capture_output=True,
            timeout=60
        )
        elapsed = time.time() - start
        stop_event.set()
        anim_thread.join()
        
        if result.returncode == 0:
            print(f"[✓] {model_name} 加载完成 ({elapsed:.1f}秒)")
            model_cache[model_name] = True
            return True
    except Exception as e:
        stop_event.set()
        anim_thread.join()
        print(f"\n[!] {model_name} 加载失败: {e}")
    return False

def parallel_load_models():
    """并行加载所有模型"""
    print("\n[⚡] 开始并行加载模型...")
    with ThreadPoolExecutor(max_workers=2) as executor:
        futures = {
            executor.submit(load_model_with_progress, MODEL_DEEPSEEK): MODEL_DEEPSEEK,
            executor.submit(load_model_with_progress, MODEL_QWEN): MODEL_QWEN
        }
        for future in as_completed(futures):
            model = futures[future]
            try:
                future.result()
            except Exception as e:
                print(f"[!] {model} 加载异常: {e}")

# ---------- 动态超时 ----------
def get_dynamic_timeout(model_name):
    """根据模型大小动态设置超时"""
    size_map = {
        "tinyllama": 180,
        "qwen:1.8b": 240,
        "default": 300
    }
    for key in size_map:
        if key in model_name:
            return size_map[key]
    return size_map["default"]

class TicTacToeGame:
    def __init__(self):
        self.board = [" "]*9
        self.turn = 0
    
    def print_board(self):
        print(f"\n {self.board[0]} | {self.board[1]} | {self.board[2]} ")
        print("-----------")
        print(f" {self.board[3]} | {self.board[4]} | {self.board[5]} ")
        print("-----------")
        print(f" {self.board[6]} | {self.board[7]} | {self.board[8]} ")
    
    def check_winner(self):
        lines = [
            [0,1,2], [3,4,5], [6,7,8],
            [0,3,6], [1,4,7], [2,5,8],
            [0,4,8], [2,4,6]
        ]
        for line in lines:
            if self.board[line[0]] == self.board[line[1]] == self.board[line[2]] != " ":
                return self.board[line[0]]
        if " " not in self.board:
            return "平局"
        return None
    
    def ai_move(self, player):
        opponent = "X" if player == "O" else "O"
        for i in range(9):
            if self.board[i] == " ":
                self.board[i] = player
                if self.check_winner() == player:
                    return
                self.board[i] = " "
        for i in range(9):
            if self.board[i] == " ":
                self.board[i] = opponent
                if self.check_winner() == opponent:
                    self.board[i] = player
                    return
                self.board[i] = " "
        empty = [i for i in range(9) if self.board[i] == " "]
        if empty:
            move = random.choice(empty)
            self.board[move] = player

def drop_caches():
    try:
        with open("/proc/sys/vm/drop_caches", "w") as f:
            f.write("3")
    except:
        pass

def set_vm_parameters():
    try:
        with open("/proc/sys/vm/swappiness", "w") as f:
            f.write("10")
    except:
        pass

def anti_seizure_init():
    global models_ready
    print(f"[⚡] 防抽风系统启动 (v{VERSION})...")
    
    os.environ['OLLAMA_TIMEOUT'] = '300'
    os.environ['OLLAMA_NUM_THREADS'] = '2'
    os.environ['OLLAMA_LOAD_TIMEOUT'] = '300'
    
    drop_caches()
    set_vm_parameters()
    
    try:
        subprocess.run(["ollama", "list"], capture_output=True, timeout=5, check=True)
        print("[✓] Ollama 服务已在运行")
    except:
        print("[!] Ollama 服务未响应，重启中...")
        subprocess.run(["pkill", "-f", "ollama"], stderr=subprocess.DEVNULL)
        time.sleep(2)
        with open(OLLAMA_LOG_PATH, "a") as log:
            subprocess.Popen(["ollama", "serve"], stdout=log, stderr=log, start_new_session=True)
        for i in range(30):
            time.sleep(2)
            try:
                subprocess.run(["ollama", "list"], capture_output=True, timeout=5, check=True)
                print("[✓] Ollama 服务已就緒")
                break
            except Exception:
                print(f"[⏳] 等待服务启动... ({i+1}/30)")
        else:
            print("[!] Ollama 服务启动超时，但继续尝试")
    
    all_ok = True
    for model in [MODEL_DEEPSEEK, MODEL_QWEN]:
        try:
            list_res = subprocess.run(["ollama", "list"], capture_output=True, text=True, timeout=15)
            if model not in list_res.stdout:
                print(f"[!] {model} 不存在，自动拉取...")
                subprocess.run(["ollama", "pull", model], timeout=900)
            else:
                print(f"[✓] {model} 已存在")
        except Exception as e:
            print(f"[!] {model} 检查失败: {e}")
            all_ok = False
    
    if all_ok:
        models_ready = True
        print("[✓] 所有模型已就绪")
        # 启动并行加载（不阻塞）
        threading.Thread(target=parallel_load_models, daemon=True).start()
    else:
        print("[!] 部分模型可能有问题")
    
    print("[✓] 防抽风完成")

def init_db():
    if not os.path.exists(DB_PATH):
        conn = sqlite3.connect(DB_PATH)
        conn.execute('CREATE TABLE IF NOT EXISTS chat_log(id INTEGER PRIMARY KEY, ts TEXT, speaker TEXT, msg TEXT)')
        conn.execute('CREATE TABLE IF NOT EXISTS code_reviews(id INTEGER PRIMARY KEY, code TEXT, review TEXT, timestamp DATETIME DEFAULT CURRENT_TIMESTAMP)')
        conn.execute('PRAGMA journal_mode=WAL')
        conn.close()

def save_msg(speaker, msg):
    for _ in range(3):
        try:
            conn = sqlite3.connect(DB_PATH, timeout=5)
            conn.execute('INSERT INTO chat_log(ts, speaker, msg) VALUES (datetime("now"), ?, ?)', (speaker, msg))
            conn.commit()
            conn.close()
            return
        except Exception as e:
            time.sleep(0.5)

def save_code_review(code, review):
    try:
        conn = sqlite3.connect(DB_PATH, timeout=5)
        conn.execute('INSERT INTO code_reviews(code, review) VALUES (?, ?)', (code, review))
        conn.commit()
        conn.close()
        print("[✓] 代码评审已保存")
    except Exception as e:
        print(f"[!] 保存失败: {e}")

def checkpoint_wal():
    try:
        conn = sqlite3.connect(DB_PATH)
        conn.execute("PRAGMA wal_checkpoint(TRUNCATE);")
        conn.close()
        print("[✓] 数据库空间已优化")
    except Exception:
        pass

def ensure_ollama_running():
    try:
        result = subprocess.run(["pgrep", "-f", "ollama serve"], capture_output=True, text=True)
        if result.returncode != 0:
            print("[✓] 启动 Ollama 服务...")
            os.makedirs(os.path.dirname(OLLAMA_LOG_PATH), exist_ok=True)
            with open(OLLAMA_LOG_PATH, "a") as log:
                subprocess.Popen(["ollama", "serve"], stdout=log, stderr=log, start_new_session=True)
            time.sleep(5)
        return True
    except Exception as e:
        print(f"[!] Ollama 启动失败: {e}")
        return False

def verify_model_working(model_name):
    test_prompt = "请用一句话回答：1+1等于几？"
    try:
        result = subprocess.run(
            ["ollama", "run", model_name],
            input=test_prompt,
            text=True,
            capture_output=True,
            timeout=60
        )
        if result.returncode != 0:
            return False
        response = result.stdout.strip()
        if not response or "error" in response.lower():
            return False
        return re.search(r'\b2\b', response) is not None
    except:
        return False

def query_ollama(model, prompt, timeout=None):
    if timeout is None:
        timeout = get_dynamic_timeout(model)
    
    if not models_ready:
        print("[!] 警告：模型状态可能异常，但将继续尝试")
    
    if len(prompt) > 3000:
        prompt = "【截断提示】上下文过长，保留末尾内容...\n\n" + prompt[-2900:]
    if not ensure_ollama_running():
        return "[ERROR] Ollama 服务异常"
    
    print(f"\n[⏳] 等待 {DISPLAY_NAME_DEEPSEEK if model == MODEL_DEEPSEEK else DISPLAY_NAME_QWEN} 响应...")
    
    try:
        start = time.time()
        result = subprocess.run(
            ["ollama", "run", model],
            input=prompt,
            text=True,
            capture_output=True,
            timeout=timeout
        )
        elapsed = time.time() - start
        print(f"[⏱️] 响应时间: {elapsed:.1f}秒")
        return result.stdout.strip() or "[NO OUTPUT]"
    except subprocess.TimeoutExpired:
        return "[TIMEOUT]"
    except Exception as e:
        return f"[RUN ERROR] {e}"

