# ========== 功能459：AI习惯追踪器 ==========
def ai_habit_tracker():
    print("\n📈 【AI习惯追踪器】")
    habits = []
    habit_file = "habits.txt"
    if os.path.exists(habit_file):
        with open(habit_file, "r", encoding='utf-8') as f:
            habits = [line.strip() for line in f.readlines() if line.strip()]
    print("当前习惯：")
    for i, h in enumerate(habits, 1):
        print(f"  {i}. {h}")
    print("\n1. 添加习惯")
    print("2. 打卡")
    print("3. 查看本月打卡记录")
    choice = input("请选择: ").strip()
    if choice == "1":
        new = input("新习惯: ").strip()
        if new:
            habits.append(new)
            with open(habit_file, "w", encoding='utf-8') as f:
                for h in habits:
                    f.write(h + "\n")
            print("✅ 已添加")
    elif choice == "2":
        if not habits:
            print("暂无习惯，请先添加")
        else:
            print("\n选择要打卡的习惯：")
            for i, h in enumerate(habits, 1):
                print(f"  {i}. {h}")
            idx = input("编号: ").strip()
            try:
                idx = int(idx) - 1
                if 0 <= idx < len(habits):
                    today = datetime.now().strftime('%Y-%m-%d')
                    log_file = f"habit_{idx+1}.log"
                    already = False
                    if os.path.exists(log_file):
                        with open(log_file, 'r') as f:
                            if today in f.read():
                                already = True
                    if already:
                        print(f"✅ {habits[idx]} 今天已经打卡过了！")
                    else:
                        with open(log_file, 'a') as f:
                            f.write(f"{today}\n")
                        print(f"✅ {habits[idx]} 打卡成功！")
                else:
                    print("编号无效")
            except:
                print("输入无效")
    elif choice == "3":
        for i, h in enumerate(habits, 1):
            log_file = f"habit_{i}.log"
            count = 0
            if os.path.exists(log_file):
                with open(log_file, 'r') as f:
                    count = len(f.readlines())
            print(f"  {h}: {count}天")
    input("\n按回车返回...")

