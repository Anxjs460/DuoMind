# ========== 功能449：AI词云生成器 ==========
def ai_word_cloud():
    print("\n☁️ 【AI词云生成器】")
    print("（模拟模式，输出词频统计）")
    text = input("输入一段文字: ").strip()
    if not text:
        print("请输入文字")
        input("\n按回车返回...")
        return
    words = text.split()
    words = [w.strip('.,!?;:()[]{}"\'').lower() for w in words]
    freq = {}
    for w in words:
        if len(w) > 1:
            freq[w] = freq.get(w, 0) + 1
    if not freq:
        print("没有足够的词汇生成词云")
    else:
        print("\n词频统计（词云数据）：")
        for w, c in sorted(freq.items(), key=lambda x: -x[1])[:15]:
            bar_len = min(c, 30)
            bar = '█' * bar_len + '░' * (30 - bar_len)
            print(f"  {w:10} | {bar} {c}")
    input("\n按回车返回...")

