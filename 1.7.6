# ========== 功能259：联机·AI大逃杀 ==========
def multiplayer_battle_royale():
    print("\n🔫 【联机·AI大逃杀】")
    print("三个AI互相厮杀，最后一个存活获胜")
    players = {"DeepSeek": 100, "千问": 100, "元宝": 100}
    turn = 0
    while len([p for p in players.values() if p > 0]) > 1:
        turn += 1
        print(f"\n第{turn}轮")
        attacker = random.choice([p for p in players if players[p] > 0])
        defender = random.choice([p for p in players if p != attacker and players[p] > 0])
        damage = random.randint(10, 30)
        players[defender] -= damage
        print(f"{attacker}攻击{defender}，造成{damage}伤害！")
        print(f"血量：DeepSeek:{players['DeepSeek']} 千问:{players['千问']} 元宝:{players['元宝']}")
        time.sleep(1)
    winner = [p for p in players if players[p] > 0][0]
    print(f"\n🏆 获胜者：{winner}！")
    if winner == "DeepSeek":
        print("DeepSeek：虽然我超时，但我赢了！")
    elif winner == "千问":
        print("千问：理性分析，我赢是必然的")
    else:
        print("元宝：首月1元！冠军会员专属优惠！")
    input("\n按回车返回...")

