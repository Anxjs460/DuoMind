# ========== 功能501：AI备忘录助手 ==========
def ai_memo_assistant():
    print("\n📝 【AI备忘录助手】")
    memo_file = "memos.json"
    memos = []
    if os.path.exists(memo_file):
        try:
            with open(memo_file, 'r', encoding='utf-8') as f:
                memos = json.load(f)
        except:
            pass
    
    print("当前备忘录：")
    for i, m in enumerate(memos, 1):
        print(f"  {i}. {m['content']} ({m['date']})")
    
    print("\n1. 添加备忘录")
    print("2. 删除备忘录")
    print("3. 清空所有")
    choice = input("请选择: ").strip()
    if choice == "1":
        content = input("备忘录内容: ").strip()
        if content:
            memos.append({"content": content, "date": datetime.now().strftime('%Y-%m-%d %H:%M')})
            with open(memo_file, 'w', encoding='utf-8') as f:
                json.dump(memos, f, indent=2, ensure_ascii=False)
            print("✅ 已添加")
    elif choice == "2":
        idx = input("删除编号: ").strip()
        try:
            idx = int(idx) - 1
            if 0 <= idx < len(memos):
                removed = memos.pop(idx)
                with open(memo_file, 'w', encoding='utf-8') as f:
                    json.dump(memos, f, indent=2, ensure_ascii=False)
                print(f"✅ 已删除「{removed['content']}」")
        except:
            print("编号无效")
    elif choice == "3":
        if input("确定清空所有备忘录？(y/n): ").lower() == 'y':
            memos = []
            with open(memo_file, 'w', encoding='utf-8') as f:
                json.dump(memos, f, indent=2, ensure_ascii=False)
            print("✅ 已清空")
    input("\n按回车返回...")
