# ========== 功能231：AI大富翁·文字版 ==========
def monopoly_game():
    print("\n🏦 【AI大富翁·文字版】")
    print("玩家：你 vs 元宝")
    board = ["起点", "北京", "上海", "广州", "深圳", "杭州", "成都", "终点"]
    positions = {"你": 0, "元宝": 0}
    money = {"你": 1000, "元宝": 1000}
    properties = {"你": [], "元宝": []}
    turn = "你"
    for i in range(10):
        print(f"\n第{i+1}轮，{turn}的回合")
        input("按回车掷骰子...")
        roll = random.randint(1, 6)
        print(f"掷出了 {roll} 点")
        positions[turn] += roll
        if positions[turn] >= len(board):
            positions[turn] = len(board) - 1
            money[turn] += 200
            print("🏁 经过起点，获得200奖金！")
        city = board[positions[turn]]
        print(f"走到了 {city}")
        if city not in ["起点", "终点"]:
            if city in properties["你"] or city in properties["元宝"]:
                owner = "你" if city in properties["你"] else "元宝"
                if owner != turn:
                    rent = 50
                    money[turn] -= rent
                    money[owner] += rent
                    print(f"💸 这是{owner}的地产，支付{rent}租金")
            else:
                buy = input(f"是否购买{city}？(200金币) (y/n): ").strip()
                if buy.lower() == 'y' and money[turn] >= 200:
                    money[turn] -= 200
                    properties[turn].append(city)
                    print(f"✅ 购买成功！")
        print(f"资金：你{money['你']}，元宝{money['元宝']}")
        if money[turn] <= 0:
            print(f"💀 {turn}破产！")
            break
        turn = "元宝" if turn == "你" else "你"
    print("\n游戏结束")
    if money["你"] > money["元宝"]:
        print("🎉 你赢了！")
    elif money["你"] < money["元宝"]:
        print("😭 元宝赢了！")
    else:
        print("🤝 平局")
    input("\n按回车返回...")

