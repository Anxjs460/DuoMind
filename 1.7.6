# ========== 功能610：语音对话循环 ==========
def voice_chat_loop():
    """语音对话主循环"""
    if not voice_chat_enabled:
        print("❌ 语音对话未开启")
        return
    
    print("\n🎤 【语音对话模式】")
    print("说一句话，AI会语音回复")
    print("输入 /exit 退出")
    
    while voice_chat_enabled:
        user_input = input("\n按回车开始录音，或输入文字（/exit退出）: ").strip()
        if user_input.lower() == '/exit':
            break
        elif user_input == '':
            audio_file = record_audio(5)
            if audio_file:
                text = transcribe_audio(audio_file)
                if text:
