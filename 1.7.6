# ========== 功能606：真实联网搜索（切换） ==========
def internet_search(query):
    """执行联网搜索，返回搜索结果摘要"""
    if not internet_search_enabled:
        return None
    
    if not SEARCH_API_KEY and SEARCH_ENGINE != "duckduckgo":
        print("⚠️ 未配置搜索API Key，请在API配置中设置")
        return None
    
    try:
        if SEARCH_ENGINE == "duckduckgo":
            encoded_query = urllib.parse.quote(query)
            url = f"https://html.duckduckgo.com/html/?q={encoded_query}"
            req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
            with urllib.request.urlopen(req, timeout=10) as response:
                html = response.read().decode('utf-8')
                import re
                results = re.findall(r'<a[^>]*class="result__a"[^>]*>([^<]+)</a>', html)
                snippets = re.findall(r'<a[^>]*class="result__snippet"[^>]*>([^<]+)</a>', html)
                if results and snippets:
                    return f"搜索结果：{results[0]} - {snippets[0][:200]}"
        return None
    except Exception as e:
        print(f"搜索失败: {e}")
        return None

def search_mode_toggle():
    """切换联网搜索模式"""
    global internet_search_enabled
    internet_search_enabled = not internet_search_enabled
    save_config()
    status = "✅ 开启" if internet_search_enabled else "❌ 关闭"
    print(f"联网搜索模式: {status}")

