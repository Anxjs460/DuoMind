# ========== 功能467：AI睡眠定时器 ==========
def ai_sleep_timer():
    print("\n😴 【AI睡眠定时器】")
    print("设置提醒睡觉的时间")
    hour = input("几点睡？（小时，0-23）: ").strip()
    minute = input("几分？（0-59）: ").strip()
    try:
        target_hour = int(hour)
        target_min = int(minute) if minute else 0
        now = datetime.now()
        target = now.replace(hour=target_hour, minute=target_min, second=0)
        if target <= now:
            target = target.replace(day=now.day + 1)
        wait_seconds = (target - now).total_seconds()
        print(f"将在 {wait_seconds/3600:.1f} 小时后提醒你睡觉")
        print("按 Ctrl+C 取消")
        time.sleep(wait_seconds)
        print("\n⏰ 该睡觉了！晚安💤")
        print("\a")
    except (ValueError, KeyboardInterrupt):
        print("\n定时器已取消")
    except Exception as e:
        print(f"错误: {e}")
        print("模拟模式：10秒后提醒")
        time.sleep(10)
        print("\n⏰ 该睡觉了！")
    input("\n按回车返回...")

