        if amount:
            with open(income_file, 'a', encoding='utf-8') as f:
                f.write(f"{datetime.now().strftime('%Y-%m-%d')} +{amount} {desc}\n")
            print("✅ 已记录")
    elif choice == "2":
        amount = input("金额: ").strip()
        desc = input("用途: ").strip()
        if amount:
            with open(expense_file, 'a', encoding='utf-8') as f:
                f.write(f"{datetime.now().strftime('%Y-%m-%d')} -{amount} {desc}\n")
            print("✅ 已记录")
    elif choice == "3":
        total_income = 0
        total_expense = 0
        if os.path.exists(income_file):
            with open(income_file, 'r') as f:
                for line in f:
                    try:
                        total_income += int(line.split('+')[1].split()[0])
                    except:
                        pass
        if os.path.exists(expense_file):
            with open(expense_file, 'r') as f:
                for line in f:
                    try:
                        total_expense += int(line.split('-')[1].split()[0])
                    except:
                        pass
        print(f"\n本月收入：{total_income}")
        print(f"本月支出：{total_expense}")
        print(f"结余：{total_income - total_expense}")
    elif choice == "4":
        print("\n📊 统计功能开发中...")
    input("\n按回车返回...")

