                    json.dump(todos, f, indent=2, ensure_ascii=False)
                print(f"✅ 已完成「{todos[idx]['task']}」")
        except:
            print("编号无效")
    elif choice == "3":
        idx = input("删除编号: ").strip()
        try:
            idx = int(idx) - 1
            if 0 <= idx < len(todos):
                removed = todos.pop(idx)
                with open(todo_file, 'w', encoding='utf-8') as f:
                    json.dump(todos, f, indent=2, ensure_ascii=False)
                print(f"✅ 已删除「{removed['task']}」")
