# ========== 功能609：语音对话模式（切换） ==========
def check_tts():
    """检查TTS是否可用"""
    global TTS_AVAILABLE
    try:
        result = subprocess.run(["which", "espeak"], capture_output=True, text=True)
        if result.returncode == 0:
            TTS_AVAILABLE = True
            return True
        else:
            print("⚠️ espeak未安装，语音输出不可用")
            print("   安装命令: pkg install espeak")
            return False
    except:
        return False

def speak_text(text):
    """文字转语音输出"""
    if TTS_AVAILABLE:
        subprocess.Popen(["espeak", text[:100]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def record_audio(duration=5):
    """录音功能（Termux）"""
    if not os.path.exists("/data/data/com.termux"):
        print("⚠️ 语音输入仅支持 Termux 环境")
        return None
    
    try:
        print(f"🎤 录音中（{duration}秒），请说话...")
        subprocess.run(["termux-microphone-record", "-f", voice_input_file, "-d", str(duration)], 
                       capture_output=True, timeout=duration+2)
        print("✅ 录音完成")
        return voice_input_file
    except Exception as e:
        print(f"录音失败: {e}")
        return None

def transcribe_audio(audio_file):
    """语音识别 - 使用whisper"""
    try:
        import whisper
        model = whisper.load_model("tiny")
        result = model.transcribe(audio_file)
        return result["text"]
    except ImportError:
        print("❌ 需要安装 openai-whisper")
        print("   安装命令: pip install openai-whisper")
        return None
    except Exception as e:
        print(f"识别失败: {e}")
        return None

def voice_chat_toggle():
