            try:
                info = proc.info
                print(f"  {i+1}. PID:{info['pid']} {info['name']} CPU:{info['cpu_percent']}%")
            except:
                pass
        pid = input("\n输入PID终止进程（回车跳过）: ").strip()
        if pid:
            try:
                p = psutil.Process(int(pid))
                p.terminate()
                print(f"✅ 已终止进程 {pid}")
            except Exception as e:
                print(f"终止失败：{e}")
    else:
        print("需要安装 psutil")
    input("\n按回车返回...")

# ========== 功能550：端口扫描器 ==========
def port_scanner():
    print("\n🔍 【端口扫描器】")
    host = input("目标IP或域名: ").strip() or "127.0.0.1"
    ports = input("端口范围（如 1-1000，默认1-100）: ").strip()
    if ports:
        try:
            start, end = map(int, ports.split('-'))
        except:
            start, end = 1, 100
    else:
        start, end = 1, 100
    
    print(f"扫描 {host} 端口 {start}-{end}...")
    open_ports = []
    for port in range(start, end+1):
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.settimeout(0.5)
            result = sock.connect_ex((host, port))
            if result == 0:
                open_ports.append(port)
                print(f"  端口 {port}: 开放")
            sock.close()
        except:
            pass
    
    print(f"\n扫描完成，发现 {len(open_ports)} 个开放端口")
    input("\n按回车返回...")

