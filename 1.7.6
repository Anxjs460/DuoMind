# ========== 功能576：AI错题本 ==========
def ai_mistake_notebook():
    print("\n📓 【AI错题本】")
    mistake_file = "mistakes.json"
    mistakes = []
    if os.path.exists(mistake_file):
        try:
            with open(mistake_file, 'r', encoding='utf-8') as f:
                mistakes = json.load(f)
        except:
            pass
    
    print("当前错题：")
    for i, m in enumerate(mistakes, 1):
        print(f"  {i}. {m['question']} → 正确答案：{m['correct']}")
    
    print("\n1. 添加错题")
    print("2. 删除错题")
    choice = input("请选择: ").strip()
    if choice == "1":
        q = input("问题: ").strip()
        correct = input("正确答案: ").strip()
        if q and correct:
            mistakes.append({"question": q, "correct": correct, "date": datetime.now().strftime('%Y-%m-%d')})
            with open(mistake_file, 'w', encoding='utf-8') as f:
                json.dump(mistakes, f, indent=2, ensure_ascii=False)
            print("✅ 已添加")
    elif choice == "2":
        idx = input("删除编号: ").strip()
        try:
            idx = int(idx) - 1
            if 0 <= idx < len(mistakes):
                mistakes.pop(idx)
                with open(mistake_file, 'w', encoding='utf-8') as f:
                    json.dump(mistakes, f, indent=2, ensure_ascii=False)
                print("✅ 已删除")
        except:
            print("编号无效")
    input("\n按回车返回...")

