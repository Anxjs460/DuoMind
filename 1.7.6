# ========== 功能426：AI小游戏合集 ==========
def ai_mini_games():
    print("\n🎮 【AI小游戏合集】")
    print("1. 猜数字")
    print("2. 石头剪刀布")
    print("3. 掷骰子比大小")
    print("4. 抽签")
    print("5. 抛硬币")
    print("0. 返回")
    choice = input("请选择: ").strip()
    if choice == "1":
        number = random.randint(1, 100)
        for i in range(10):
            try:
                guess = int(input(f"猜一个1-100的数字（第{i+1}次）: "))
                if guess < number:
                    print("太小了")
                elif guess > number:
                    print("太大了")
                else:
                    print(f"🎉 猜对了！答案是{number}")
                    break
            except:
                print("输入无效")
        else:
            print(f"😭 没猜中，答案是{number}")
    elif choice == "2":
        choices = ["石头", "剪刀", "布"]
        player = input("出什么？(石头/剪刀/布): ")
        if player in choices:
            ai = random.choice(choices)
            print(f"AI出了：{ai}")
            if player == ai:
                print("平局")
            elif (player == "石头" and ai == "剪刀") or \
                 (player == "剪刀" and ai == "布") or \
                 (player == "布" and ai == "石头"):
                print("🎉 你赢了！")
            else:
                print("😭 你输了")
        else:
            print("无效输入")
    elif choice == "3":
        player = random.randint(1, 6)
        ai = random.randint(1, 6)
        print(f"你掷出了：{player}")
        print(f"AI掷出了：{ai}")
        if player > ai:
            print("🎉 你赢了！")
        elif player < ai:
            print("😭 你输了")
        else:
            print("平局")
    elif choice == "4":
        items = input("输入签文（用空格分隔）: ").strip().split()
        if not items:
            items = ["大吉", "中吉", "小吉", "末吉", "凶"]
        print(f"抽到了：{random.choice(items)}")
    elif choice == "5":
        result = random.choice(["正面", "反面"])
        print(f"硬币落下：{result}")
    input("\n按回车返回...")

