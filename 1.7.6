def zip_tool():
    print("\n🗜️ 【压缩解压工具】")
    print("1. 压缩文件/文件夹")
    print("2. 解压文件")
    choice = input("请选择: ").strip()
    if choice == "1":
        source = input("要压缩的路径: ").strip()
        dest = input("输出zip文件名: ").strip()
        if not dest.endswith('.zip'):
            dest += '.zip'
        try:
            import zipfile
            with zipfile.ZipFile(dest, 'w', zipfile.ZIP_DEFLATED) as zf:
                if os.path.isfile(source):
                    zf.write(source, os.path.basename(source))
                elif os.path.isdir(source):
                    for root, dirs, files in os.walk(source):
                        for file in files:
                            filepath = os.path.join(root, file)
                            arcname = os.path.relpath(filepath, os.path.dirname(source))
                            zf.write(filepath, arcname)
            print(f"✅ 压缩完成：{dest}")
        except ImportError:
            print("zipfile 是内置模块，无需安装")
        except Exception as e:
            print(f"压缩失败：{e}")
    elif choice == "2":
        zip_file = input("zip文件路径: ").strip()
        dest = input("解压目录: ").strip()
        try:
            import zipfile
            with zipfile.ZipFile(zip_file, 'r') as zf:
                zf.extractall(dest)
            print(f"✅ 解压完成：{dest}")
        except Exception as e:
            print(f"解压失败：{e}")
    input("\n按回车返回...")

