        p2 = query_ollama(second, f"反驳：{p1}")
        print(p2)
        save_msg(name2, p2)
    else:
        print(f"\n【{name1}】")
        r1 = query_ollama(first, full_prompt)
        print(r1)
        save_msg(name1, r1)
        print(f"\n【{name2}】")
