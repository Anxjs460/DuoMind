    elif choice == "4":
        from fractions import Fraction
        num1, den1 = random.randint(1, 20), random.randint(2, 20)
        num2, den2 = random.randint(1, 20), random.randint(2, 20)
        op = random.choice(["+", "-"])
        print(f"\n计算：{num1}/{den1} {op} {num2}/{den2} = ?")
        print("（输入小数或分数，如 0.5 或 1/2）")
        answer = input("答案: ").strip()
        f1 = Fraction(num1, den1)
        f2 = Fraction(num2, den2)
        correct = f1 + f2 if op == "+" else f1 - f2
        try:
            if '/' in answer:
                user_frac = Fraction(answer)
                if user_frac == correct:
                    print("✅ 正确！")
                else:
                    print(f"❌ 错误，答案是 {correct}")
            else:
                user_float = float(answer)
                if abs(user_float - float(correct)) < 0.01:
                    print("✅ 正确！")
                else:
                    print(f"❌ 错误，答案是 {correct}")
        except:
            print(f"❌ 输入无效，答案是 {correct}")
    input("\n按回车返回...")

